# Copy to .env and fill in. Never commit .env.

# AI: stub mode is the default and needs no keys.
AI_STUB_MODE=true
AI_TIMEOUT_SECONDS=20

# IBM watsonx.ai (used only when AI_STUB_MODE=false)
# API key:    cloud.ibm.com -> Manage -> Access (IAM) -> API keys
# Project ID: dataplatform.cloud.ibm.com/wx -> your project -> Manage -> General
# URL:        your region endpoint, e.g. https://us-south.ml.cloud.ibm.com
WATSONX_API_KEY=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# P2 three-way receipt matching (not implemented in P0)
THREE_WAY_ENABLED=false

# SQLite database path
EDI_DB_PATH=edi_resolve.db
