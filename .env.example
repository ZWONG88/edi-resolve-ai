# Copy to .env and fill in. Never commit .env.

# ── Database ──────────────────────────────────────────────
# Path to the SQLite audit database (relative to project root)
DATABASE_PATH=data/edi_resolve.db

# ── AI Provider ───────────────────────────────────────────
# Options: "mock" | "mock_unavailable" | "watsonx"
#   mock             offline rules-based stub (default; no keys needed)
#   mock_unavailable always returns AI_UNAVAILABLE (demo of safe AI failure)
#   watsonx          IBM watsonx.ai Granite (needs the keys below)
AI_PROVIDER=mock
AI_TIMEOUT_SECONDS=20

# Required when AI_PROVIDER=watsonx
# AI_API_KEY:          cloud.ibm.com -> Manage -> Access (IAM) -> API keys
# WATSONX_PROJECT_ID:  dataplatform.cloud.ibm.com/wx -> your project -> Manage -> General
# WATSONX_URL:         your region endpoint
AI_API_KEY=
AI_MODEL_ID=ibm/granite-3-8b-instruct
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=

# ── Reconciliation ────────────────────────────────────────
# Three-way matching (850 + 810 + 861) per the team rules doc. false = two-way only
# (no auto-approval or 820 generation).
THREE_WAY_ENABLED=true
# Rules doc 4.1: a line variance at or below this is waived (DE_MINIMIS_PASSED).
DE_MINIMIS_LINE_TOLERANCE=1.00
# Rules doc 4.2: blocked cash above this needs AP review before an 820 is generated.
HIGH_VALUE_HOLD_THRESHOLD=500.00
# Where generated (never transmitted) EDI 820 remittance files are written.
REMITTANCE_DIR=data/processed/820

# ── Retry Policy ──────────────────────────────────────────
# Maximum attempts for transient service errors before TECHNICAL_HOLD.
MAX_RETRY_ATTEMPTS=3
