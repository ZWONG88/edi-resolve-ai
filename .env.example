# Copy to .env and fill in. Never commit .env.

# ── Database ──────────────────────────────────────────────
# Path to the SQLite audit database (relative to project root)
DATABASE_PATH=data/edi_resolve.db

# ── AI Provider ───────────────────────────────────────────
# Options: "mock" | "mock_unavailable" | "watsonx"
#   mock             offline rules-based stub (default; no keys needed)
#   mock_unavailable always returns AI_UNAVAILABLE (demo of safe AI failure)
#   watsonx          IBM watsonx.ai Granite (needs the keys below)
AI_PROVIDER=mock
AI_TIMEOUT_SECONDS=20

# Required when AI_PROVIDER=watsonx
# AI_API_KEY:          cloud.ibm.com -> Manage -> Access (IAM) -> API keys
# WATSONX_PROJECT_ID:  dataplatform.cloud.ibm.com/wx -> your project -> Manage -> General
# WATSONX_URL:         your region endpoint
AI_API_KEY=
AI_MODEL_ID=ibm/granite-3-8b-instruct
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=

# ── Feature Flags ─────────────────────────────────────────
# Set to true only after P0 AT01–AT24 pass and PM approves P2 enablement.
THREE_WAY_ENABLED=false

# ── Retry Policy ──────────────────────────────────────────
# Maximum attempts for transient service errors before TECHNICAL_HOLD.
MAX_RETRY_ATTEMPTS=3
